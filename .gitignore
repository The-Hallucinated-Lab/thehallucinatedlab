# --- Secrets -------------------------------------------------------
# Nothing here should hold a credential, but git history is permanent:
# anything that lands here has to be rotated, not just deleted. These
# patterns exist so a stray local file never becomes a commit in the
# first place.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
*service-account*.json
secrets.json

# --- OS / editor ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# --- Python package (python/) --------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# --- Local tooling -------------------------------------------------
.cache/
*.log

# Local Claude Code config
.claude/
.claude/worktrees/

# --- Orchestrator harness (CLAUDE.md) --------------------------------
# Scripts and expert role files are tracked; runtime state is not.
.orchestrator/logs/
.orchestrator/tmp/
.orchestrator/baseline/
.orchestrator/session.md

# --- Downloaded datasets --------------------------------------------
# torchvision and friends default to ./data, and the MNIST download alone
# is 63.5MB of binaries that git can never compress and never forget -- it
# was committed once and had to be taken back out. The data is
# reproducible from a one-line download; the repo is not.
#
# Anchored to the root on purpose. An unanchored `data/` also matches
# python/thehallucinatedlab/data/, which is where the packaged tool spec
# lives -- it silently dropped that file from a commit once, and CI caught
# the drift only because a test compares the two copies.
/data/
*.idx3-ubyte
*.idx1-ubyte

# --- Pipeline artefacts ----------------------------------------------
# `thl pipeline eda x.csv` writes x.eda/ and `thl pipeline rag doc.pdf`
# writes doc.rag/ beside their input. Real output, not source.
*.eda/
*.rag/
