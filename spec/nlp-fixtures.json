{
  "$comment": "The contract between the two intent-parser implementations. test/nlp.test.js and python/tests/test_nlp.py both run every case here, so nlp.js and thehallucinatedlab.nlp cannot drift apart without a red build. When you teach one parser a new phrasing, add the case here FIRST and make both sides pass it.",
  "notes": {
    "format": "A directional preposition (to / into / as) decides which format wins when an utterance mentions two ('png to webp' -> webp). With no preposition, the last format token wins.",
    "quality": "Explicit cues win in this order: 'quality N' / 'q N' / 'quality=N', then 'N quality', then 'at N' / 'at N%', then 'N%'. A bare number only counts when it appears AFTER the resolved format token, which keeps 'convert 2 images to png' from reading 2 as a quality.",
    "range": "The parser reports what was said. Bounds are enforced later by validateArgs, so 'quality 200' parses to 200 and is rejected at validation rather than silently clamped.",
    "colors": "Hex (#rgb or #rrggbb) plus a deliberately small named set: black, white, gray/grey."
  },
  "cases": [
    { "input": "convert this to png", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },
    { "input": "convert this to PNG", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },
    { "input": "Convert This To Png!", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },
    { "input": "   convert   this   to   png   ", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },

    { "input": "convert to jpg", "expect": { "tool": "convert", "args": { "format": "jpeg" }, "missing": [] } },
    { "input": "convert to jpeg", "expect": { "tool": "convert", "args": { "format": "jpeg" }, "missing": [] } },
    { "input": "convert to jfif", "expect": { "tool": "convert", "args": { "format": "jpeg" }, "missing": [] } },
    { "input": "convert to webp", "expect": { "tool": "convert", "args": { "format": "webp" }, "missing": [] } },
    { "input": "convert to avif", "expect": { "tool": "convert", "args": { "format": "avif" }, "missing": [] } },

    { "input": "make this a png", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },
    { "input": "turn this into a webp", "expect": { "tool": "convert", "args": { "format": "webp" }, "missing": [] } },
    { "input": "save as avif", "expect": { "tool": "convert", "args": { "format": "avif" }, "missing": [] } },
    { "input": "export it as jpg", "expect": { "tool": "convert", "args": { "format": "jpeg" }, "missing": [] } },
    { "input": "i want png", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },
    { "input": "png", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },

    { "input": "jpg to png", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },
    { "input": "png to webp", "expect": { "tool": "convert", "args": { "format": "webp" }, "missing": [] } },
    { "input": "convert my photo from png to jpeg", "expect": { "tool": "convert", "args": { "format": "jpeg" }, "missing": [] } },
    { "input": "change this webp into a png", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },

    { "input": "make it a jpg at 80 quality", "expect": { "tool": "convert", "args": { "format": "jpeg", "quality": 80 }, "missing": [] } },
    { "input": "png to webp, quality 75", "expect": { "tool": "convert", "args": { "format": "webp", "quality": 75 }, "missing": [] } },
    { "input": "convert to jpeg quality=60", "expect": { "tool": "convert", "args": { "format": "jpeg", "quality": 60 }, "missing": [] } },
    { "input": "convert to jpeg q 55", "expect": { "tool": "convert", "args": { "format": "jpeg", "quality": 55 }, "missing": [] } },
    { "input": "convert to jpeg at 50%", "expect": { "tool": "convert", "args": { "format": "jpeg", "quality": 50 }, "missing": [] } },
    { "input": "webp 60%", "expect": { "tool": "convert", "args": { "format": "webp", "quality": 60 }, "missing": [] } },
    { "input": "convert to webp 80", "expect": { "tool": "convert", "args": { "format": "webp", "quality": 80 }, "missing": [] } },
    { "input": "png 90", "expect": { "tool": "convert", "args": { "format": "png", "quality": 90 }, "missing": [] } },
    { "input": "convert 2 images to png", "expect": { "tool": "convert", "args": { "format": "png" }, "missing": [] } },
    { "input": "convert to jpeg quality 200", "expect": { "tool": "convert", "args": { "format": "jpeg", "quality": 200 }, "missing": [] } },
    { "input": "convert to jpeg at 0", "expect": { "tool": "convert", "args": { "format": "jpeg", "quality": 0 }, "missing": [] } },

    { "input": "convert to jpg on a black background", "expect": { "tool": "convert", "args": { "format": "jpeg", "background": "#000000" }, "missing": [] } },
    { "input": "jpeg with a white background", "expect": { "tool": "convert", "args": { "format": "jpeg", "background": "#ffffff" }, "missing": [] } },
    { "input": "make it a jpg with #123456 background", "expect": { "tool": "convert", "args": { "format": "jpeg", "background": "#123456" }, "missing": [] } },
    { "input": "convert to jpeg background #f00", "expect": { "tool": "convert", "args": { "format": "jpeg", "background": "#ff0000" }, "missing": [] } },
    { "input": "jpg at 85 quality on a grey background", "expect": { "tool": "convert", "args": { "format": "jpeg", "quality": 85, "background": "#808080" }, "missing": [] } },

    { "input": "convert image", "expect": { "tool": "convert", "args": {}, "missing": ["format"] } },
    { "input": "convert this picture", "expect": { "tool": "convert", "args": {}, "missing": ["format"] } },
    { "input": "change format", "expect": { "tool": "convert", "args": {}, "missing": ["format"] } },
    { "input": "convert my photo at 70 quality", "expect": { "tool": "convert", "args": { "quality": 70 }, "missing": ["format"] } },

    { "input": "", "expect": { "tool": null, "args": {}, "missing": [] } },
    { "input": "   ", "expect": { "tool": null, "args": {}, "missing": [] } },
    { "input": "hello", "expect": { "tool": null, "args": {}, "missing": [] } },
    { "input": "what can you do", "expect": { "tool": null, "args": {}, "missing": [] } },
    { "input": "tell me about the lab", "expect": { "tool": null, "args": {}, "missing": [] } },
    { "input": "convert", "expect": { "tool": null, "args": {}, "missing": [] } },
    { "input": "convert 100 usd to eur", "expect": { "tool": null, "args": {}, "missing": [] } },
    { "input": "resize this to 800x600", "expect": { "tool": null, "args": {}, "missing": [] } },
    { "input": "how do i install the library", "expect": { "tool": null, "args": {}, "missing": [] } },
    { "input": "write me a python script", "expect": { "tool": null, "args": {}, "missing": [] } }
  ]
}
